<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- ================= -->
  <!-- Materials -->
  <!-- ================= -->


  <material name="arm_gray">

    <color rgba="0.45 0.45 0.45 1"/>

  </material>


  <material name="hand_black">

    <color rgba="0.1 0.1 0.1 1"/>

  </material>



  <!-- ================= -->
  <!-- Arm Macro -->
  <!-- ================= -->


  <xacro:macro name="arm"
               params="prefix side">


    <!-- Upper Arm -->


    <link name="${prefix}_upper_arm">


      <visual>

        <geometry>

          <cylinder
            radius="0.05"
            length="0.30"/>

        </geometry>


        <origin
          xyz="0 0 -0.15"/>


        <material name="arm_gray"/>


      </visual>



      <collision>

        <geometry>

          <cylinder
            radius="0.05"
            length="0.30"/>

        </geometry>


        <origin
          xyz="0 0 -0.15"/>


      </collision>



      <inertial>

        <mass value="1.0"/>


        <origin
          xyz="0 0 -0.15"/>


        <inertia

          ixx="0.01"
          ixy="0"
          ixz="0"

          iyy="0.01"
          iyz="0"

          izz="0.005"/>


      </inertial>


    </link>




    <!-- Forearm -->


    <link name="${prefix}_forearm">


      <visual>


        <geometry>

          <cylinder
            radius="0.04"
            length="0.30"/>

        </geometry>


        <origin
          xyz="0 0 -0.15"/>


        <material name="arm_gray"/>


      </visual>



      <collision>

        <geometry>

          <cylinder
            radius="0.04"
            length="0.30"/>

        </geometry>


        <origin
          xyz="0 0 -0.15"/>


      </collision>



      <inertial>

        <mass value="0.8"/>


        <origin
          xyz="0 0 -0.15"/>


        <inertia

          ixx="0.008"
          ixy="0"
          ixz="0"

          iyy="0.008"
          iyz="0"

          izz="0.004"/>


      </inertial>


    </link>




    <!-- Hand -->


    <link name="${prefix}_hand">


      <visual>


        <geometry>

          <box size="0.12 0.08 0.18"/>

        </geometry>


        <origin
          xyz="0 0 -0.09"/>


        <material name="hand_black"/>


      </visual>



      <collision>


        <geometry>

          <box size="0.12 0.08 0.18"/>

        </geometry>


        <origin
          xyz="0 0 -0.09"/>


      </collision>



      <inertial>

        <mass value="0.3"/>


        <origin
          xyz="0 0 -0.09"/>


        <inertia

          ixx="0.003"
          ixy="0"
          ixz="0"

          iyy="0.003"
          iyz="0"

          izz="0.002"/>


      </inertial>


    </link>




    <!-- Shoulder Joint -->


    <joint name="${prefix}_shoulder_joint"
           type="revolute">


      <parent link="torso_link"/>


      <child link="${prefix}_upper_arm"/>


      <origin
        xyz="0 ${side} 0.15"/>


      <axis
        xyz="1 0 0"/>


      <limit

        lower="-1.57"
        upper="1.57"
        effort="20"
        velocity="1"/>


    </joint>




    <!-- Elbow Joint -->


    <joint name="${prefix}_elbow_joint"
           type="revolute">


      <parent link="${prefix}_upper_arm"/>


      <child link="${prefix}_forearm"/>


      <origin
        xyz="0 0 -0.30"/>


      <axis
        xyz="1 0 0"/>


      <limit

        lower="0"
        upper="2.5"
        effort="15"
        velocity="1"/>


    </joint>




    <!-- Wrist -->


    <joint name="${prefix}_wrist_joint"
           type="fixed">


      <parent link="${prefix}_forearm"/>


      <child link="${prefix}_hand"/>


      <origin
        xyz="0 0 -0.30"/>


    </joint>



  </xacro:macro>


</robot>

