<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <material name="pelvis_blue">

    <color rgba="0 0.3 1 1"/>

  </material>



  <xacro:macro name="pelvis">


    <link name="pelvis_link">


      <visual>

        <geometry>

          <box size="0.35 0.30 0.20"/>

        </geometry>


        <origin
          xyz="0 0 0"/>


        <material name="pelvis_blue"/>


      </visual>



      <collision>

        <geometry>

          <box size="0.35 0.30 0.20"/>

        </geometry>


        <origin
          xyz="0 0 0"/>


      </collision>



      <inertial>


        <mass value="2.5"/>


        <origin
          xyz="0 0 0"/>


        <inertia

          ixx="0.02"

          ixy="0"

          ixz="0"

          iyy="0.02"

          iyz="0"

          izz="0.01"/>


      </inertial>


    </link>


  </xacro:macro>


</robot>

