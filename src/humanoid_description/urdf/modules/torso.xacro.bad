<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->


  <material name="torso_blue">

    <color rgba="0 0.3 1 1"/>

  </material>



  <!-- ===================== -->
  <!-- Torso Macro -->
  <!-- ===================== -->


  <xacro:macro name="torso">



    <!-- ================= -->
    <!-- Torso Link -->
    <!-- ================= -->


    <link name="torso_link">



      <!-- Visual -->

      <visual>


        <geometry>

          <box size="0.45 0.30 0.55"/>

        </geometry>



        <origin

          xyz="0 0 0"/>



        <material name="torso_blue"/>


      </visual>





      <!-- Collision -->

      <collision>


        <geometry>

          <box size="0.45 0.30 0.55"/>

        </geometry>



        <origin

          xyz="0 0 0"/>


      </collision>





      <!-- Inertial -->

      <inertial>


        <mass value="5.0"/>



        <origin

          xyz="0 0 0"/>



        <inertia


          ixx="0.12"


          ixy="0"


          ixz="0"


          iyy="0.10"


          iyz="0"


          izz="0.08"/>


      </inertial>



    </link>





    <!-- ================= -->
    <!-- Torso-Pelvis Joint -->
    <!-- ================= -->


    <joint name="torso_joint"

           type="fixed">


      <parent link="pelvis_link"/>


      <child link="torso_link"/>


      <origin

        xyz="0 0 0.20"/>


    </joint>



  </xacro:macro>



</robot>
