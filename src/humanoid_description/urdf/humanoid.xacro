<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="humanoid_v2_5">


  <!-- ================= -->
  <!-- Include Modules -->
  <!-- ================= -->


  <xacro:include
    filename="$(find humanoid_description)/urdf/modules/pelvis.xacro"/>


  <xacro:include
    filename="$(find humanoid_description)/urdf/modules/torso.xacro"/>


  <xacro:include
    filename="$(find humanoid_description)/urdf/modules/legs.xacro"/>


  <xacro:include
    filename="$(find humanoid_description)/urdf/modules/arms.xacro"/>


  <xacro:include
    filename="$(find humanoid_description)/urdf/modules/head.xacro"/>



  <!-- ================= -->
  <!-- Base -->
  <!-- ================= -->


  <link name="base_link">


    <visual>

      <geometry>

        <box size="0.4 0.3 0.5"/>

      </geometry>


      <origin
        xyz="0 0 0.25"/>


      <material name="base_blue">

        <color rgba="0 0 1 1"/>

      </material>


    </visual>


    <collision>

      <geometry>

        <box size="0.4 0.3 0.5"/>

      </geometry>


      <origin
        xyz="0 0 0.25"/>

    </collision>


    <inertial>

      <mass value="5"/>


      <origin
        xyz="0 0 0.25"/>


      <inertia

        ixx="0.1"
        ixy="0"
        ixz="0"

        iyy="0.1"
        iyz="0"

        izz="0.08"/>


    </inertial>


  </link>



  <!-- ================= -->
  <!-- Generate Modules -->
  <!-- ================= -->


  <xacro:pelvis/>

  <xacro:torso/>


  <xacro:leg prefix="left"/>

  <xacro:leg prefix="right"/>


  <xacro:arm prefix="left"/>

  <xacro:arm prefix="right"/>


  <xacro:head/>




  <!-- ================= -->
  <!-- Base To Pelvis -->
  <!-- ================= -->


  <joint name="base_to_pelvis"
         type="fixed">

    <parent link="base_link"/>

    <child link="pelvis_link"/>


    <origin
      xyz="0 0 0.85"/>

  </joint>





  <!-- ================= -->
  <!-- Pelvis To Torso -->
  <!-- ================= -->


  <joint name="pelvis_to_torso"
         type="fixed">


    <parent link="pelvis_link"/>

    <child link="torso_link"/>


    <origin
      xyz="0 0 0.35"/>


  </joint>





  <!-- ================= -->
  <!-- Hip Joints -->
  <!-- ================= -->


  <joint name="left_hip_joint"
         type="revolute">


    <parent link="pelvis_link"/>

    <child link="left_thigh"/>


    <origin
      xyz="0 0.15 0"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="-1.57"
      upper="1.57"
      effort="20"
      velocity="1"/>


  </joint>



  <joint name="right_hip_joint"
         type="revolute">


    <parent link="pelvis_link"/>

    <child link="right_thigh"/>


    <origin
      xyz="0 -0.15 0"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="-1.57"
      upper="1.57"
      effort="20"
      velocity="1"/>


  </joint>





  <!-- ================= -->
  <!-- Shoulder -->
  <!-- ================= -->


  <joint name="left_shoulder_joint"
         type="revolute">


    <parent link="torso_link"/>

    <child link="left_upper_arm"/>


    <origin
      xyz="0 0.25 0.15"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="-1.57"
      upper="1.57"
      effort="30"
      velocity="2"/>


  </joint>




  <joint name="right_shoulder_joint"
         type="revolute">


    <parent link="torso_link"/>

    <child link="right_upper_arm"/>


    <origin
      xyz="0 -0.25 0.15"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="-1.57"
      upper="1.57"
      effort="30"
      velocity="2"/>


  </joint>





  <!-- ================= -->
  <!-- Elbows -->
  <!-- ================= -->


  <joint name="left_elbow_joint"
         type="revolute">


    <parent link="left_upper_arm"/>

    <child link="left_forearm"/>


    <origin
      xyz="0 0 -0.30"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="0"
      upper="2.5"
      effort="20"
      velocity="2"/>


  </joint>




  <joint name="right_elbow_joint"
         type="revolute">


    <parent link="right_upper_arm"/>

    <child link="right_forearm"/>


    <origin
      xyz="0 0 -0.30"/>


    <axis xyz="1 0 0"/>


    <limit

      lower="0"
      upper="2.5"
      effort="20"
      velocity="2"/>


  </joint>





  <!-- ================= -->
  <!-- Wrist -->
  <!-- ================= -->


  <joint name="left_wrist_joint"
         type="fixed">


    <parent link="left_forearm"/>

    <child link="left_hand"/>


    <origin
      xyz="0 0 -0.28"/>


  </joint>



  <joint name="right_wrist_joint"
         type="fixed">


    <parent link="right_forearm"/>

    <child link="right_hand"/>


    <origin
      xyz="0 0 -0.28"/>


  </joint>




  <!-- ================= -->
  <!-- Neck -->
  <!-- ================= -->


  <joint name="neck_joint"
         type="fixed">


    <parent link="torso_link"/>

    <child link="neck_link"/>


    <origin
      xyz="0 0 0.35"/>


  </joint>



  <joint name="head_joint"
         type="fixed">


    <parent link="neck_link"/>

    <child link="head_link"/>


    <origin
      xyz="0 0 0.15"/>


  </joint>



</robot>

